# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini (AI Studio / Cloud)
GEMINI_API_KEY=your_gemini_api_key
# Preferred model (tried first). On quota/busy we auto-switch to fallbacks.
GEMINI_MODEL=gemini-3.8-flash
# Optional comma-separated extras (otherwise uses built-in pool)
# GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
